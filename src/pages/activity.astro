---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogHeatmap from '../components/widgets/BlogHeatmap.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getSiteConfig } from '../data/site';

const { site } = await getSiteConfig();
const posts = await getCollection('blog', ({ data }) => !data.draft);
const resources = (await getCollection('projects')).filter(
  ({ id, data }) => id !== 'index' && !data.draft,
);
const events = [
  ...posts.map((post) => ({
    kind: 'Guide published',
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    href: `/blog/${post.id}/`,
    group: post.data.categories[0] ?? 'Guide',
  })),
  ...resources.map((resource) => ({
    kind: 'Resource added',
    title: resource.data.title,
    description: resource.data.description,
    date: resource.data.date,
    href: `/resources/${resource.id}/`,
    group: resource.data.categories[0] ?? 'Resource',
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<BaseLayout
  title={`Publication Activity | ${site.title}`}
  description="A dated record of Havemoon guide, resource, research, and tool updates."
>
  <main class="activity-page" data-pagefind-body>
    <header>
      <p><a href="/">havemoon</a> / activity</p>
      <h1>Publication activity</h1>
      <span
        >A transparent dated record of new guides and reusable buyer resources. Counts below come
        from published content files, not generated engagement data.</span
      >
    </header>

    <section class="activity-heatmap" aria-label="Guide publication and update heatmap">
      <BlogHeatmap weeks={30} showLatest={true} latestCount={2} excludeDraft={true} />
    </section>

    <section class="timeline" aria-labelledby="timeline-title">
      <div class="timeline-heading">
        <h2 id="timeline-title">Update log</h2>
        <span>{events.length} published entries</span>
      </div>
      <div class="timeline-list">
        {
          events.map((event) => (
            <article>
              <time datetime={event.date.toISOString()}>
                <FormattedDate date={event.date} />
              </time>
              <span class="timeline-dot" aria-hidden="true" />
              <div>
                <p>
                  {event.kind} · {event.group}
                </p>
                <h3>
                  <a href={event.href}>{event.title}</a>
                </h3>
                <span>{event.description}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .activity-page {
    width: min(100%, 980px);
    margin: 0 auto;
    padding: 104px 32px 72px;
  }
  header {
    padding-bottom: 28px;
    border-bottom: 1px solid var(--hm-border);
  }
  header > p {
    margin: 0 0 18px;
    color: var(--hm-text-faint);
    font: 0.8rem var(--hm-font-mono);
  }
  header > p a {
    text-decoration: none;
  }
  header h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 2.8rem);
  }
  header > span {
    display: block;
    max-width: 720px;
    margin-top: 10px;
    color: var(--hm-text-secondary);
  }
  .activity-heatmap {
    margin-top: 28px;
    padding: 18px;
    border: 1px solid var(--hm-border);
  }
  .activity-heatmap :global(.heatmap-card) {
    padding: 0;
  }
  .timeline {
    margin-top: 38px;
  }
  .timeline-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
  }
  .timeline-heading h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .timeline-heading span {
    color: var(--hm-text-faint);
    font: 0.72rem var(--hm-font-mono);
  }
  .timeline-list {
    border-top: 1px solid var(--hm-border);
  }
  .timeline-list article {
    display: grid;
    grid-template-columns: 110px 14px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--hm-border);
  }
  .timeline-list time {
    color: var(--hm-text-faint);
    font: 0.72rem var(--hm-font-mono);
  }
  .timeline-dot {
    width: 9px;
    height: 9px;
    margin-top: 4px;
    border: 2px solid var(--hm-mark);
    border-radius: 50%;
    background: var(--hm-page);
  }
  .timeline-list p {
    margin: 0;
    color: var(--hm-mark);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .timeline-list h3 {
    margin: 3px 0 0;
    font-size: 1rem;
  }
  .timeline-list h3 a {
    text-decoration: none;
  }
  .timeline-list div > span {
    display: block;
    margin-top: 5px;
    color: var(--hm-text-secondary);
    font-size: 0.82rem;
  }
  @media (max-width: 650px) {
    .activity-page {
      padding: 84px 20px 48px;
    }
    .timeline-list article {
      grid-template-columns: 82px minmax(0, 1fr);
      gap: 10px;
    }
    .timeline-dot {
      display: none;
    }
  }
</style>

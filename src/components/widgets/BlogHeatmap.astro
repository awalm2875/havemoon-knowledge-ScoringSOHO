---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { getSiteConfig } from '../../data/site';
import { createRecentBlogHeatmap, getDateKey, type HeatmapDay } from '../../utils/blog-heatmap';
import { getUiText } from '../../utils/ui-text';

interface Props {
  weeks?: number;
  showLatest?: boolean;
  latestCount?: number;
  excludeDraft?: boolean;
  dateArchiveBaseHref?: string;
  startDate?: Date | string | null;
  compact?: boolean;
}

const {
  weeks = 24,
  showLatest = true,
  latestCount = 1,
  excludeDraft = true,
  dateArchiveBaseHref,
  startDate,
  compact = false,
} = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
const heatmap = createRecentBlogHeatmap(posts, weeks, latestCount, startDate);
const ui = getUiText(await getSiteConfig());
const heatmapLabel = startDate
  ? ui.heatmap.writingSince(heatmap.startDate)
  : ui.heatmap.recentWeeks(heatmap.weeks);
const formatDate = new Intl.DateTimeFormat(ui.locale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const latestDateKeys = new Set(heatmap.latestPosts.map((post) => getDateKey(post.date)));
const activeOrderByDate = new Map(
  heatmap.days
    .filter((day) => !day.isFuture && day.count > 0)
    .map((day, activeIndex) => [day.date, activeIndex]),
);

function getDayTitle(day: HeatmapDay) {
  if (day.isFuture) return `${day.date}: ${ui.heatmap.upcoming}`;

  const activityLabel = day.count === 1 ? 'content update' : 'content updates';
  const titleLines = day.posts
    .slice(0, 5)
    .map((post) => `- ${post.event === 'published' ? 'Published' : 'Updated'}: ${post.title}`);
  const overflowLine = day.posts.length > 5 ? ['...'] : [];

  return [`${day.date}: ${day.count} ${activityLabel}`, ...titleLines, ...overflowLine].join('\n');
}

function getDayHref(day: HeatmapDay) {
  if (dateArchiveBaseHref && day.count > 0) {
    return `${dateArchiveBaseHref.replace(/\/$/, '')}/${day.date}/`;
  }

  return day.posts[0]?.href;
}
---

<article
  class:list={['glass-card', 'heatmap-card', { compact }]}
  data-activity-heatmap={compact ? 'compact' : 'full'}
>
  <div class="stats-row">
    <div class="stat-item">
      <strong>{heatmap.totalPosts}</strong>
      <span>{ui.heatmap.totalPosts}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.activeDays}</strong>
      <span>{ui.heatmap.activeDays}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.currentStreak}</strong>
      <span>{ui.heatmap.dayStreak}</span>
    </div>
  </div>

  {
    showLatest && heatmap.latestPosts.length > 0 && (
      <aside class="latest-tip" aria-label={ui.heatmap.latestPublishedPosts}>
        <strong>{ui.heatmap.latest}</strong>
        <div class="latest-list">
          {heatmap.latestPosts.map((post) => (
            <a
              class="latest-link"
              href={post.href}
              aria-label={ui.heatmap.openLatestPost(post.title)}
            >
              <em>{post.title}</em>
              <time datetime={post.date.toISOString()}>{formatDate.format(post.date)}</time>
              <span class="latest-icon" aria-hidden="true">
                <Icon name="external" size={15} />
              </span>
            </a>
          ))}
        </div>
      </aside>
    )
  }

  <div class="rhythm-grid" aria-label={heatmapLabel}>
    <div class="weekday-column" aria-hidden="true">
      {ui.heatmap.weekdays.map((weekday) => <span>{weekday}</span>)}
    </div>

    <div class="heatmap-cells" style={`--week-count: ${heatmap.weeks};`}>
      {
        heatmap.days.map((day) => {
          if (day.isFuture) {
            return <span class="heatmap-cell future-cell" aria-hidden="true" />;
          }

          const href = getDayHref(day);
          const isActive = day.count > 0;
          const isLatest = latestDateKeys.has(day.date);
          const activeIndex = activeOrderByDate.get(day.date) ?? 0;
          const content = (
            <span
              class:list={[
                'heatmap-cell',
                `level-${day.level}`,
                { 'active-cell': isActive, 'latest-cell': isLatest },
              ]}
              style={isActive ? `--cell-delay: ${activeIndex * 95}ms;` : undefined}
              title={getDayTitle(day)}
              aria-hidden="true"
            />
          );

          return href ? (
            <a class="cell-link" href={href} aria-label={getDayTitle(day)}>
              {content}
            </a>
          ) : (
            <span class="cell-link static-cell" aria-label={getDayTitle(day)}>
              {content}
            </span>
          );
        })
      }
    </div>
  </div>

  <footer>
    <span>{ui.heatmap.less}</span>
    {[0, 1, 2, 3, 4].map((level) => <i class={`heatmap-cell level-${level}`} />)}
    <span>{ui.heatmap.more}</span>
  </footer>
</article>

<script>
  const initializeActivityHeatmaps = () => {
    const heatmaps = document.querySelectorAll<HTMLElement>('[data-activity-heatmap="compact"]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    heatmaps.forEach((heatmap) => {
      if (heatmap.dataset.revealReady === 'true') return;
      heatmap.dataset.revealReady = 'true';

      if (reduceMotion || !('IntersectionObserver' in window)) {
        heatmap.classList.add('is-visible');
        return;
      }

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          heatmap.classList.toggle('is-visible', entry.isIntersecting);
        },
        { threshold: 0.35 },
      );

      observer.observe(heatmap);
    });
  };

  initializeActivityHeatmaps();
  document.addEventListener('astro:page-load', initializeActivityHeatmaps);
</script>

<style>
  .heatmap-card {
    display: grid;
    gap: 16px;
    padding: 20px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .heatmap-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .heatmap-card.compact {
    grid-template-columns: minmax(230px, 0.85fr) minmax(300px, 1.15fr);
    grid-template-areas:
      'stats calendar'
      'legend calendar';
    gap: 10px 24px;
    align-items: center;
  }

  .heatmap-card.compact .stats-row {
    grid-area: stats;
  }

  .heatmap-card.compact .rhythm-grid {
    grid-area: calendar;
    justify-self: end;
    width: max-content;
  }

  .heatmap-card.compact footer {
    grid-area: legend;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat-item {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stat-item strong {
    color: var(--paper-ink);
    font-size: 1.12rem;
    line-height: 1;
  }

  .stat-item span {
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip {
    display: grid;
    gap: 6px;
    padding: 10px 11px;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .latest-list {
    display: grid;
    gap: 4px;
  }

  .latest-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 24px;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .latest-tip strong {
    color: var(--paper-accent);
    font-size: 0.7rem;
    line-height: 1.15;
  }

  .latest-tip em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip time {
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .latest-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    color: var(--paper-accent);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .latest-link:hover .latest-icon,
  .latest-link:focus-visible .latest-icon {
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .latest-link:focus-visible {
    border-radius: 7px;
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 28%, transparent);
    outline-offset: 3px;
  }

  .rhythm-grid {
    --cell-size: 8px;
    --cell-gap: 2.5px;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .weekday-column {
    display: grid;
    grid-template-rows: repeat(3, var(--cell-size));
    gap: calc(var(--cell-size) + var(--cell-gap));
    color: var(--paper-ink-faint);
    font-size: 0.62rem;
    line-height: 1;
  }

  .heatmap-cells {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell-size));
    grid-auto-columns: var(--cell-size);
    gap: var(--cell-gap);
    width: calc(
      (var(--cell-size) * var(--week-count)) + (var(--cell-gap) * (var(--week-count) - 1))
    );
    max-width: 100%;
  }

  .heatmap-cell,
  .cell-link {
    display: block;
    width: var(--cell-size);
    height: var(--cell-size);
    min-width: 8px;
    min-height: 8px;
  }

  .cell-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .cell-link:hover .heatmap-cell {
    outline: 1px solid var(--paper-line-strong);
    outline-offset: 1px;
  }

  .heatmap-cell {
    border-radius: 2.5px;
    background: rgba(102, 125, 109, 0.12);
    box-shadow: inset 0 0 0 1px var(--paper-line);
  }

  .heatmap-card.compact.is-visible .active-cell {
    animation: heatmap-cell-in 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--cell-delay, 0ms);
  }

  .heatmap-cell.latest-cell {
    position: relative;
    z-index: 1;
    background: #244f87;
    outline: 2px solid rgba(49, 95, 157, 0.45);
    outline-offset: 2px;
  }

  .latest-cell::after {
    position: absolute;
    inset: -3px;
    border: 1.5px solid #315f9d;
    border-radius: 4px;
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  .heatmap-card.compact.is-visible .latest-cell::after {
    animation: latest-cell-pulse 2.7s 950ms ease-out infinite;
  }

  .future-cell {
    background: transparent;
    box-shadow: none;
  }

  .level-0 {
    background: rgba(102, 125, 109, 0.16);
  }

  .level-1 {
    background: #7293c2;
    box-shadow: inset 0 0 0 1px #5279ad;
  }

  .level-2 {
    background: #577db3;
  }

  .level-3 {
    background: #3f68a1;
  }

  .level-4 {
    background: #2a528b;
  }

  footer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
  }

  footer .heatmap-cell {
    --cell-size: 9px;
  }

  @keyframes heatmap-cell-in {
    from {
      opacity: 0;
      transform: scale(0.55);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes latest-cell-pulse {
    0% {
      opacity: 0;
      transform: scale(0.75);
    }
    18% {
      opacity: 0.85;
    }
    72%,
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  @media (max-width: 1180px) and (min-width: 821px) {
    .rhythm-grid {
      --cell-size: 8px;
    }
  }

  @media (max-width: 820px) {
    .heatmap-card {
      gap: 14px;
      padding: 0;
      overflow: hidden;
    }

    .heatmap-card.compact {
      grid-template-columns: 1fr;
      grid-template-areas:
        'stats'
        'calendar'
        'legend';
      gap: 13px;
    }

    .heatmap-card.compact .rhythm-grid {
      justify-self: stretch;
      width: 100%;
    }

    .rhythm-grid {
      --cell-gap: 2.5px;
      grid-template-columns: 22px minmax(0, 1fr);
      overflow: hidden;
      width: 100%;
    }

    .heatmap-cells {
      grid-template-rows: repeat(7, auto);
      grid-auto-columns: minmax(0, 1fr);
      width: 100%;
      max-width: 360px;
    }

    .heatmap-cells .heatmap-cell,
    .heatmap-cells .cell-link {
      width: 100%;
      height: auto;
      min-width: 0;
      min-height: 0;
      aspect-ratio: 1;
    }

    .weekday-column {
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .heatmap-card.compact.is-visible .active-cell,
    .heatmap-card.compact.is-visible .latest-cell::after {
      animation: none;
    }
  }
</style>

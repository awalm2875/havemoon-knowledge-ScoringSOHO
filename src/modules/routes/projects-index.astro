---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { resourceGroups } from '../../data/knowledge';
import { getSiteConfig } from '../../data/site';
import { sortBlogPostsForArchive } from '../../utils/content-dates';

const { site, pages } = await getSiteConfig();
const resources = sortBlogPostsForArchive(
  (await getCollection('projects')).filter(({ id, data }) => id !== 'index' && !data.draft),
);
---

<BaseLayout title={`${pages.projects.title} | ${site.title}`} description={pages.projects.subtitle}>
  <main class="resources-page" data-pagefind-body>
    <header class="resources-header">
      <p><a href="/">havemoon</a> / resources</p>
      <h1>{pages.projects.title}</h1>
      <span>{pages.projects.subtitle}</span>
      <small>{pages.projects.note}</small>
    </header>

    <nav class="resource-jump" aria-label="Resource groups">
      {
        resourceGroups.map((group) => (
          <a href={`#${group.toLowerCase().replaceAll(' ', '-')}`}>{group}</a>
        ))
      }
    </nav>

    {
      resourceGroups.map((group) => {
        const groupResources = resources.filter((resource) =>
          resource.data.categories.includes(group),
        );
        return (
          <section class="resource-group" id={group.toLowerCase().replaceAll(' ', '-')}>
            <div class="group-heading">
              <h2>{group}</h2>
              <span>
                {groupResources.length} {groupResources.length === 1 ? 'resource' : 'resources'}
              </span>
            </div>
            <div class="resource-list">
              {groupResources.map((resource) => (
                <article>
                  <div>
                    <h3>
                      <a href={`/resources/${resource.id}/`}>{resource.data.title}</a>
                    </h3>
                    <p>{resource.data.description}</p>
                    <div class="resource-tags">
                      {resource.data.tags.slice(0, 4).map((tag) => (
                        <span>{tag}</span>
                      ))}
                    </div>
                  </div>
                  <div class="resource-meta">
                    {resource.data.sticky && <strong>Recommended</strong>}
                    <FormattedDate date={resource.data.date} />
                    <a
                      href={`/resources/${resource.id}/`}
                      aria-label={`Open ${resource.data.title}`}
                    >
                      →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }
  </main>
</BaseLayout>

<style>
  .resources-page {
    width: min(100%, 1040px);
    margin: 0 auto;
    padding: 104px 32px 72px;
  }
  .resources-header {
    padding-bottom: 30px;
    border-bottom: 1px solid var(--hm-border);
  }
  .resources-header > p {
    margin: 0 0 18px;
    color: var(--hm-text-faint);
    font: 0.8rem var(--hm-font-mono);
  }
  .resources-header > p a {
    text-decoration: none;
  }
  .resources-header h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 2.8rem);
  }
  .resources-header > span {
    display: block;
    max-width: 740px;
    margin-top: 10px;
    color: var(--hm-text-secondary);
    font-size: 1.04rem;
  }
  .resources-header > small {
    display: block;
    max-width: 740px;
    margin-top: 9px;
    color: var(--hm-text-faint);
    font-size: 0.78rem;
  }
  .resource-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 15px 0;
    border-bottom: 1px solid var(--hm-border);
  }
  .resource-jump a {
    font-size: 0.8rem;
    text-decoration: none;
  }
  .resource-group {
    margin-top: 36px;
    scroll-margin-top: 88px;
  }
  .group-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 11px;
  }
  .group-heading h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .group-heading span {
    color: var(--hm-text-faint);
    font: 0.72rem var(--hm-font-mono);
  }
  .resource-list {
    border-top: 1px solid var(--hm-border);
  }
  .resource-list article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 116px;
    gap: 28px;
    padding: 19px 0;
    border-bottom: 1px solid var(--hm-border);
  }
  .resource-list h3 {
    margin: 0;
    font-size: 1.04rem;
  }
  .resource-list h3 a {
    text-decoration: none;
  }
  .resource-list p {
    max-width: 720px;
    margin: 5px 0 0;
    color: var(--hm-text-secondary);
    font-size: 0.85rem;
  }
  .resource-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 9px;
  }
  .resource-tags span {
    padding: 1px 6px;
    border: 1px solid var(--hm-border);
    border-radius: 10px;
    color: var(--hm-text-faint);
    font-size: 0.66rem;
  }
  .resource-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    color: var(--hm-text-faint);
    font-size: 0.72rem;
  }
  .resource-meta strong {
    color: var(--hm-mark);
    font-size: 0.7rem;
  }
  .resource-meta > a {
    margin-top: auto;
    font-size: 1rem;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .resources-page {
      padding: 84px 20px 48px;
    }
    .resource-list article {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .resource-meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .resource-meta > a {
      margin: 0 0 0 auto;
    }
  }
</style>
